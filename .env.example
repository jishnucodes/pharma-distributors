# ==========================================
# L & K Pharmaceutical Distribution Platform
# Environment Configuration
# ==========================================

# 1. DATABASE CONFIGURATION
# Provisionally configured for PostgreSQL (Neon Serverless Postgres recommended provider)
# Format for Neon: postgres://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_password@ep-sample-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# For offline local testing without Neon account:
# DATABASE_URL="file:./dev.db" (when using sqlite schema) or local PostgreSQL "postgresql://postgres:postgres@localhost:5432/lkpharma"

# 2. EXPRESS BACKEND API
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000

# 3. AUTHENTICATION & SECURITY
JWT_SECRET="lk-pharma-super-secret-jwt-key-2026-distribution-platform"
JWT_EXPIRES_IN="7d"

# 4. NEXT.JS FRONTEND
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
